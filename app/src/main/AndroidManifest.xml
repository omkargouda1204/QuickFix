<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Required on Android 13+ (API 33+) to show push notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".QuickFixApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickFix"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- FCM default notification channel for background notifications -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="provider_apps" />

        <!-- FCM default notification icon -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- FCM default notification color -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/primary" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Splash Screen as the launcher activity -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.QuickFix.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- Forgot Password Activity -->
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:parentActivityName=".LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Signup / Register Activity -->
        <activity
            android:name=".SignupActivity"
            android:exported="false"
            android:parentActivityName=".LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Email Verification Activity (after signup) -->
        <activity
            android:name=".EmailVerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Activity (Home) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Provider Onboarding / Business Registration -->
        <activity
            android:name=".ProviderOnboardingActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Provider Application — "Become a Service Provider" form -->
        <activity
            android:name=".ProviderApplicationActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Application Status — shows pending/approved/rejected state -->
        <activity
            android:name=".ApplicationStatusActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Provider Dashboard (shown when role = provider) -->
        <activity
            android:name=".ProviderDashboardActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- ═════════════════════════════════════════════════════════════ -->
        <!-- ADMIN PANEL ACTIVITIES                                        -->
        <!-- ═════════════════════════════════════════════════════════════ -->

        <!-- Admin Login Activity -->
        <activity
            android:name=".AdminLoginActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- Admin Notifications Activity -->
        <activity
            android:name=".AdminNotificationsActivity"
            android:exported="false"
            android:parentActivityName=".AdminDashboardActivity" />

        <!-- Admin Dashboard Activity -->
        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Business Approval Activity (redirects to AdminProviderApprovalActivity) -->
        <activity
            android:name=".BusinessApprovalActivity"
            android:exported="false"
            android:parentActivityName=".AdminDashboardActivity" />

        <!-- Admin Provider Approval Activity — full management screen -->
        <activity
            android:name=".AdminProviderApprovalActivity"
            android:exported="false"
            android:parentActivityName=".AdminDashboardActivity" />

        <!-- Admin Provider Management Activity (provider_profiles list) -->
        <activity
            android:name=".AdminProviderManagementActivity"
            android:exported="false"
            android:parentActivityName=".AdminDashboardActivity" />

        <!-- User Management Activity -->
        <activity
            android:name=".UserManagementActivity"
            android:exported="false"
            android:parentActivityName=".AdminDashboardActivity" />

        <!-- Service Management Activity -->
        <activity
            android:name=".ServiceManagementActivity"
            android:exported="false"
            android:parentActivityName=".AdminDashboardActivity" />

        <!-- Content Management Activity -->
        <activity
            android:name=".ContentManagementActivity"
            android:exported="false"
            android:parentActivityName=".AdminDashboardActivity" />

        <!-- Banner Management Activity -->
        <activity
            android:name=".BannerManagementActivity"
            android:exported="false"
            android:parentActivityName=".ContentManagementActivity" />

        <!-- Offer Management Activity -->
        <activity
            android:name=".OfferManagementActivity"
            android:exported="false"
            android:parentActivityName=".ContentManagementActivity" />

        <!-- Admin Settings Activity -->
        <activity
            android:name=".AdminSettingsActivity"
            android:exported="false"
            android:parentActivityName=".AdminDashboardActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Admin Bookings Activity -->
        <activity
            android:name=".AdminBookingsActivity"
            android:exported="false"
            android:parentActivityName=".AdminDashboardActivity" />

        <!-- Reports & Analytics Activity -->
        <activity
            android:name=".ReportsAnalyticsActivity"
            android:exported="false"
            android:parentActivityName=".AdminDashboardActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Maintenance Screen — shown to users/providers when maintenance mode is ON -->
        <activity
            android:name=".MaintenanceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Profile Activity -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile Details / Edit Profile Activity -->
        <activity
            android:name=".ProfileDetailsActivity"
            android:exported="false"
            android:parentActivityName=".ProfileActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Emergency Help Activity -->
        <activity
            android:name=".EmergencyHelpActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- User Bookings Activity -->
        <activity
            android:name=".UserBookingsActivity"
            android:exported="false"
            android:parentActivityName=".ProfileActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notifications Activity -->
        <activity
            android:name=".NotificationsActivity"
            android:exported="false"
            android:parentActivityName=".ProfileActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ProfileActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Help & Support Activity -->
        <activity
            android:name=".HelpSupportActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- FullScreen Image Activity -->
        <activity
            android:name=".FullScreenImageActivity"
            android:exported="false"
            android:parentActivityName=".AdminProviderApprovalActivity" />

        <!-- Provider Application Detail Activity (Admin) -->
        <activity
            android:name=".ProviderApplicationDetailActivity"
            android:exported="false"
            android:parentActivityName=".AdminProviderApprovalActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- PROVIDER DASHBOARD ACTIVITIES                                  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- My Bookings Activity -->
        <activity
            android:name=".MyBookingsActivity"
            android:exported="false"
            android:parentActivityName=".ProviderDashboardActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProviderEmergencyRequestActivity"
            android:exported="false"
            android:parentActivityName=".ProviderDashboardActivity"
            android:windowSoftInputMode="adjustResize" />


        <!-- Earnings Activity -->
        <activity
            android:name=".EarningsActivity"
            android:exported="false"
            android:parentActivityName=".ProviderDashboardActivity" />

        <!-- Business Profile Activity -->
        <activity
            android:name=".BusinessProfileActivity"
            android:exported="false"
            android:parentActivityName=".ProviderDashboardActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- FCM SERVICE — handles token refresh & incoming push messages   -->
        <!-- Token is stored silently in Supabase; NEVER shown in the UI    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Messages Activity -->
        <activity
            android:name=".MessagesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- AI Assistant Activity -->
        <activity
            android:name=".AiChatActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ChatThreadsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <!-- Search Results Activity -->
        <activity
            android:name=".SearchResultsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Provider List Activity — single provider listing screen -->
        <activity
            android:name=".ProviderListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Providers Activity — single category-based providers screen -->
        <activity
            android:name=".ProvidersActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Service Providers Activity — compatibility route -->
        <activity
            android:name=".ServiceProvidersActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Providers List Activity — legacy route kept for backward compatibility -->
        <activity
            android:name=".ProvidersListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Provider Detail Activity — full profile of a single provider -->
        <activity
            android:name=".ProviderDetailActivity"
            android:exported="false"
            android:parentActivityName=".ProviderListActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Categories Activity — full grid of all service categories -->
        <activity
            android:name=".CategoriesActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

    </application>
</manifest>