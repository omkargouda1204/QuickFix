<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.QuickFix.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeErrorColor">@color/error_red</item>
        <item name="hintTextColor">@color/input_hint</item>
        <item name="startIconTint">@color/input_icon</item>
        <item name="endIconTint">@color/input_icon</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="Widget.QuickFix.TextInputLayout.Filled" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="boxStrokeColor">@color/divider</item>
        <item name="hintTextColor">@color/input_hint</item>
        <item name="startIconTint">@color/input_icon</item>
        <item name="endIconTint">@color/input_icon</item>
    </style>

    <style name="Widget.QuickFix.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/input_text</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.QuickFix.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.QuickFix.Button.Rounded" parent="Widget.Material3.Button">
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.QuickFix.Button.Rounded.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.QuickFix.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/surface_variant</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="checkedIconTint">@color/primary</item>
    </style>

    <style name="Widget.QuickFix.Button.SectionChip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">20dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
