<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — Light mode (dark mode applied via AppCompatDelegate) -->
    <style name="Base.Theme.QuickFix" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="colorSurface">#F5F5F5</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorBackground">#FFFFFF</item>
        <item name="colorOnBackground">#000000</item>
        <item name="colorOnBackgroundSecondary">#666666</item>
        <item name="colorError">#D32F2F</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="materialAlertDialogTheme">@style/Theme.QuickFix.AdminDialog</item>
        <item name="alertDialogTheme">@style/Theme.QuickFix.AdminDialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <!-- Bottom sheets follow theme -->
        <item name="bottomSheetDialogTheme">@style/Theme.QuickFix.BottomSheet</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="materialButtonStyle">@style/Widget.QuickFix.Button</item>
        <item name="chipStyle">@style/Widget.QuickFix.Chip.Filter</item>
        <item name="textInputStyle">@style/Widget.QuickFix.TextInputLayout</item>
    </style>

    <style name="Theme.QuickFix" parent="Base.Theme.QuickFix" />

    <!-- Bottom Sheet — follows theme -->
    <style name="Theme.QuickFix.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/card_bg</item>
    </style>

    <!-- Admin panel dialogs -->
    <style name="Theme.QuickFix.AdminDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/divider</item>
    </style>

    <!-- Splash Screen Theme — always light/blue gradient, never dark -->
    <style name="Theme.QuickFix.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_gradient_background</item>
        <item name="android:statusBarColor">@color/splash_gradient_start</item>
        <item name="android:navigationBarColor">@color/splash_gradient_end</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
