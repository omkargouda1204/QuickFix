<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back Button -->

        <!-- Logo -->
        <ImageView
            android:id="@+id/logoOTP"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:src="@drawable/logo_q"
            android:contentDescription="@string/app_name" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/otp_verification_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/otp_verification_subtitle"
            android:textSize="16sp"
            android:textColor="@color/input_hint"
            android:layout_gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Email Display -->
        <TextView
            android:id="@+id/emailDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="user@example.com"
            android:textSize="14sp"
            android:textColor="@color/splash_blue"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- OTP Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/otpSignupLayout"
            style="@style/Widget.QuickFix.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="@color/input_background"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/input_stroke"
            app:hintTextColor="@color/input_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/otpSignupInput"
                style="@style/Widget.QuickFix.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/otp_code_hint"
                android:inputType="number"
                android:maxLength="6"
                android:textColor="@color/input_text"
                android:textColorHint="@color/input_hint"
                android:textSize="16sp"
                android:padding="16dp"
                android:gravity="center"
                android:textAlignment="center" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- OTP Instructions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please enter the 6-digit code sent to your email"
            android:textSize="13sp"
            android:textColor="@color/input_hint"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Verify Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/verifyButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/verify_button"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/splash_blue"
            app:cornerRadius="12dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp" />

        <!-- Resend OTP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Didn't receive the code? "
                android:textSize="14sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/resendOtpLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resend_otp"
                android:textSize="14sp"
                android:textColor="@color/splash_blue"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Timer for Resend -->
        <TextView
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend in 60s"
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_gravity="center"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
