<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F6FF">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_user_mgmt_header"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    app:navigationIcon="@drawable/ic_arrow_back_white"
                    app:titleTextColor="@color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Application Details"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />

                <!-- Status badge in header -->
                <TextView
                    android:id="@+id/tvHeaderStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending"
                    android:textColor="#E65100"
                    android:background="@drawable/bg_status_pending"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeaderBusinessName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Business Name"
                android:textColor="#CCE3FF"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- ── Section: Contact Info ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:text="Contact Information"
                android:textColor="#1E88E5"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E8EAF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Business Name -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_business" app:tint="#1E88E5"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Business Name" android:textColor="#9E9E9E"
                                android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvBusinessName"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#0D0D0D" android:textSize="15sp"
                                android:layout_marginTop="2dp" android:text="-" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Owner Name -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_person" app:tint="#1E88E5"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Owner Name" android:textColor="#9E9E9E"
                                android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvOwnerName"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#0D0D0D" android:textSize="15sp"
                                android:layout_marginTop="2dp" android:text="-" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Email -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_email" app:tint="#1E88E5"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Email" android:textColor="#9E9E9E"
                                android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvEmail"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#0D0D0D" android:textSize="15sp"
                                android:layout_marginTop="2dp" android:text="-" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Phone -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_phone" app:tint="#1E88E5"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Phone" android:textColor="#9E9E9E"
                                android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvPhone"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#0D0D0D" android:textSize="15sp"
                                android:layout_marginTop="2dp" android:text="-" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Section: Service Info ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:text="Service Information"
                android:textColor="#00897B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E8EAF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Category -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_services" app:tint="#00897B"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Category" android:textColor="#9E9E9E"
                                android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvCategory"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#0D0D0D" android:textSize="15sp"
                                android:layout_marginTop="2dp" android:text="-" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- City -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_city" app:tint="#00897B"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="City" android:textColor="#9E9E9E"
                                android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvCity"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#0D0D0D" android:textSize="15sp"
                                android:layout_marginTop="2dp" android:text="-" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Address -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_location" app:tint="#00897B"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Address" android:textColor="#9E9E9E"
                                android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvAddress"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#0D0D0D" android:textSize="15sp"
                                android:layout_marginTop="2dp" android:text="-" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Experience -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_calendar" app:tint="#00897B"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Experience" android:textColor="#9E9E9E"
                                android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvExperience"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#0D0D0D" android:textSize="15sp"
                                android:layout_marginTop="2dp" android:text="-" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Description -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="top">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_content" app:tint="#00897B"
                            android:layout_marginEnd="12dp"
                            android:layout_marginTop="2dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Description" android:textColor="#9E9E9E"
                                android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvDescription"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:textColor="#333333" android:textSize="14sp"
                                android:layout_marginTop="2dp"
                                android:lineSpacingMultiplier="1.4"
                                android:text="-" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Section: Application Meta ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:text="Application Info"
                android:textColor="#7B1FA2"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E8EAF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Applied Date -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_calendar" app:tint="#7B1FA2"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Date Applied" android:textColor="#9E9E9E"
                                android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvDate"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#0D0D0D" android:textSize="15sp"
                                android:layout_marginTop="2dp" android:text="-" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Rejection Reason (visible only when rejected) -->
                    <LinearLayout
                        android:id="@+id/layoutRejectionReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_close" app:tint="#D32F2F"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Rejection Reason" android:textColor="#D32F2F"
                                android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvRejectionReason"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#B71C1C" android:textSize="14sp"
                                android:layout_marginTop="2dp" android:text="-" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Section: Uploaded Files ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:text="Uploaded Files"
                android:textColor="#E65100"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E8EAF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Business Image -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_business" app:tint="#E65100"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Business Image" android:textColor="#9E9E9E"
                                android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvBusinessImage"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#1E88E5" android:textSize="14sp"
                                android:layout_marginTop="2dp"
                                android:text="Tap to view image"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?attr/selectableItemBackgroundBorderless" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ID Proof (admin only — uses signed URL) -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_lock" app:tint="#D32F2F"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="ID Proof (Admin Only)" android:textColor="#D32F2F"
                                android:textSize="11sp" android:textStyle="bold" />
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical"
                                android:layout_marginTop="4dp">
                                <ProgressBar
                                    android:id="@+id/pbIdProof"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:indeterminateTint="#D32F2F"
                                    android:visibility="gone"
                                    android:layout_marginEnd="6dp" />
                                <TextView android:id="@+id/tvIdProof"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:textColor="#D32F2F" android:textSize="14sp"
                                    android:text="Tap to view ID proof (secure)"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:background="?attr/selectableItemBackgroundBorderless" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Action Buttons (only for pending) ── -->
            <LinearLayout
                android:id="@+id/layoutActionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReject"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:text="Reject"
                    android:textColor="#D32F2F"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="#D32F2F"
                    app:strokeWidth="1.5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApprove"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Approve"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#388E3C"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Loading overlay for approve/reject -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/primary"
                android:visibility="gone"
                android:layout_marginHorizontal="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

