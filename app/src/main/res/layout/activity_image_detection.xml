<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_admin_header_gradient"
            android:elevation="4dp"
            app:navigationIcon="@drawable/ic_arrow_back_white"
            app:title="AI Service Detection"
            app:titleTextColor="@android:color/white" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Modern Header Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_camera"
                        android:background="@drawable/bg_circle_gradient"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AI Service Detection"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Smart detection for your home service needs"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                </LinearLayout>

                <!-- Image Preview Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@color/card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivSelectedImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_camera"
                            android:background="#F8F9FA"
                            android:padding="32dp"
                            app:tint="@color/text_secondary_light" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Modern Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTakePhoto"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:text="📷 Camera"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="32dp"
                        app:icon="@drawable/ic_camera"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChooseGallery"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="🖼️ Gallery"
                        android:textColor="@color/primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="32dp"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="2dp"
                        app:icon="@drawable/ic_image"
                        app:iconTint="@color/primary"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />

                </LinearLayout>

                <!-- Modern Loading Section -->
                <LinearLayout
                    android:id="@+id/loadingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminateTint="@color/primary"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvLoadingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍 AI is analyzing your image..."
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Modern Result Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/resultCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="12dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="2dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <!-- Result Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginBottom="20dp">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_check_circle"
                                android:background="@drawable/bg_circle_gradient"
                                android:padding="12dp"
                                android:layout_marginBottom="12dp"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/tvResultTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Detection Complete"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:id="@+id/tvResultSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="AI has analyzed your image successfully"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"
                                android:gravity="center"
                                android:layout_marginBottom="16dp" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/text_secondary"
                            android:alpha="0.2"
                            android:layout_marginBottom="20dp" />

                        <!-- Detected Service -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_rounded_light"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_book_service"
                                android:layout_marginEnd="12dp"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Detected Service"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tvDetectedService"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Plumbing"
                                android:textColor="@color/primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:gravity="end" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetectedLabels"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="Top labels: -"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:padding="12dp"
                            android:background="@drawable/bg_rounded_light" />

                        <TextView
                            android:id="@+id/tvConfidence"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Confidence: 85%"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="24dp"
                            android:gravity="center" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBookService"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:text="🔧 Book This Service"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="32dp"
                            app:icon="@drawable/ic_book_service"
                            app:iconTint="@color/white"
                            app:iconGravity="textStart"
                            app:iconPadding="12dp"
                            android:visibility="gone" />

                        <!-- Modern Manual Selection -->
                        <LinearLayout
                            android:id="@+id/layoutManualSelection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="👆 Choose service manually"
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginBottom="16dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="2">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnManualPlumbing"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:text="🔧 Plumbing"
                                    android:textSize="14sp"
                                    app:cornerRadius="24dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnManualElectrical"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="⚡ Electrical"
                                    android:textSize="14sp"
                                    app:cornerRadius="24dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal"
                                android:weightSum="2">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnManualCleaning"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:text="🧹 Cleaning"
                                    android:textSize="14sp"
                                    app:cornerRadius="24dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnManualRepair"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="🔨 Repair"
                                    android:textSize="14sp"
                                    app:cornerRadius="24dp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
