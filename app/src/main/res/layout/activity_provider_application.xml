<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F6FF">

    <!-- ══════════════ APP BAR ══════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_onboarding_header"
            app:navigationIcon="@drawable/ic_arrow_back_white"
            app:titleTextColor="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_onboarding_header"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp"
            android:paddingTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_circle_white"
                    android:gravity="center"
                    android:text="🏪"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Become a Service Provider"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="List your business for FREE on QuickFix"
                        android:textColor="#CCE3FF"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Step indicators -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="28dp" android:layout_height="28dp"
                        android:background="@drawable/bg_step_circle_active"
                        android:gravity="center" android:text="1" android:textColor="@color/white"
                        android:textStyle="bold" android:textSize="12sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="Details"
                        android:textColor="#CCE3FF" android:textSize="10sp" />
                </LinearLayout>

                <View android:layout_width="0dp" android:layout_height="2dp"
                    android:layout_weight="0.8" android:background="#4488CC"
                    android:layout_marginBottom="14dp" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="28dp" android:layout_height="28dp"
                        android:background="@drawable/bg_step_circle_active"
                        android:gravity="center" android:text="2" android:textColor="@color/white"
                        android:textStyle="bold" android:textSize="12sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="Service"
                        android:textColor="#CCE3FF" android:textSize="10sp" />
                </LinearLayout>

                <View android:layout_width="0dp" android:layout_height="2dp"
                    android:layout_weight="0.8" android:background="#4488CC"
                    android:layout_marginBottom="14dp" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="28dp" android:layout_height="28dp"
                        android:background="@drawable/bg_step_circle_inactive"
                        android:gravity="center" android:text="3" android:textColor="#AACCEE"
                        android:textStyle="bold" android:textSize="12sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="Terms"
                        android:textColor="#AACCEE" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══════════════ SCROLLABLE BODY ══════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/outerScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Pending status badge -->
            <LinearLayout
                android:id="@+id/layoutStatusBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@color/warning_bg"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="14dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏳  Your application is under review. Admin will contact you soon."
                    android:textColor="@color/warning_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </LinearLayout>

            <!-- ─────── SECTION 1: Business Details ─────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="10dp">
                <View android:layout_width="4dp" android:layout_height="20dp"
                    android:background="@color/primary" android:layout_marginEnd="10dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Business Details"
                    android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@color/info_bg" android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" android:text="Step 1"
                    android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Business Name label + field -->
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Business Name *" android:textColor="@color/text_primary"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_marginBottom="6dp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutBusinessName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        app:startIconDrawable="@drawable/ic_business" app:startIconTint="@color/primary"
                        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                        app:hintTextColor="@color/primary" android:hint="e.g. QuickFix Plumbing Co.">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBusinessName"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textColor="@color/text_primary" android:textColorHint="@color/input_hint"
                            android:textSize="15sp" android:inputType="textCapWords"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Letters only · no numbers or special characters"
                        android:textColor="#9E9E9E" android:textSize="11sp"
                        android:layout_marginStart="4dp" android:layout_marginBottom="18dp" />

                    <!-- Owner Name label + field -->
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Owner / Full Name *" android:textColor="@color/text_primary"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_marginBottom="6dp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutOwnerName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        app:startIconDrawable="@drawable/ic_person" app:startIconTint="@color/primary"
                        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                        app:hintTextColor="@color/primary" android:hint="Enter your full name">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOwnerName"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textColor="@color/text_primary" android:textColorHint="@color/input_hint"
                            android:textSize="15sp" android:inputType="textPersonName"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email label + field (read-only) — SEPARATE ROW -->
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Email Address" android:textColor="@color/text_primary"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_marginBottom="6dp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutEmail"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        app:startIconDrawable="@drawable/ic_email" app:startIconTint="@color/primary"
                        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="@color/card_bg" app:boxStrokeColor="@color/divider"
                        app:hintTextColor="@color/primary" android:hint="Email from your account">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textColor="#555555" android:textColorHint="@color/input_hint"
                            android:textSize="15sp" android:inputType="textEmailAddress"
                            android:focusable="false" android:focusableInTouchMode="false"
                            android:clickable="false" android:cursorVisible="false"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginStart="4dp" android:layout_marginBottom="18dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🔒 " android:textSize="11sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Linked to your account · cannot be changed"
                            android:textColor="#9E9E9E" android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Phone Number label + field — SEPARATE ROW, full width -->
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Phone Number *" android:textColor="@color/text_primary"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_marginBottom="6dp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPhone"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        app:startIconDrawable="@drawable/ic_phone" app:startIconTint="@color/primary"
                        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                        app:hintTextColor="@color/primary" android:hint="Enter 10-digit mobile number">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textColor="@color/text_primary" android:textColorHint="@color/input_hint"
                            android:textSize="15sp" android:inputType="phone"
                            android:maxLength="10" android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Must be exactly 10 digits (mobile number)"
                        android:textColor="#9E9E9E" android:textSize="11sp"
                        android:layout_marginStart="4dp" android:layout_marginBottom="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────── SECTION 2: Service Information ─────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="10dp">
                <View android:layout_width="4dp" android:layout_height="20dp"
                    android:background="@color/accent_teal" android:layout_marginEnd="10dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Service Information"
                    android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@color/surface_variant_alt" android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" android:text="Step 2"
                    android:textColor="@color/accent_teal" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Service Category -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Service Category *" android:textColor="@color/text_primary"
                        android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCategory"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        app:startIconDrawable="@drawable/ic_services" app:startIconTint="@color/accent_teal"
                        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                        app:hintTextColor="@color/accent_teal" android:hint="Select your service type">
                        <AutoCompleteTextView
                            android:id="@+id/spinnerCategory"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textColor="@color/text_primary" android:textColorHint="@color/input_hint"
                            android:textSize="15sp" android:inputType="none"
                            android:focusable="false" android:cursorVisible="false"
                            android:padding="16dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- City -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="City *" android:textColor="@color/text_primary"
                        android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCity"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        app:startIconDrawable="@drawable/ic_city" app:startIconTint="@color/accent_teal"
                        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                        app:hintTextColor="@color/accent_teal" android:hint="Enter your city name">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCity"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textColor="@color/text_primary" android:textColorHint="@color/input_hint"
                            android:textSize="15sp" android:inputType="textCapWords"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Years of Experience -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Years of Experience *" android:textColor="@color/text_primary"
                        android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutExperience"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        app:startIconDrawable="@drawable/ic_calendar" app:startIconTint="@color/accent_teal"
                        app:suffixText="yrs"
                        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                        app:hintTextColor="@color/accent_teal" android:hint="e.g. 5">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etExperience"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textColor="@color/text_primary" android:textColorHint="@color/input_hint"
                            android:textSize="15sp" android:inputType="number"
                            android:maxLength="2" android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Numbers only (1–99 years)"
                        android:textColor="#9E9E9E" android:textSize="11sp"
                        android:layout_marginStart="4dp" android:layout_marginBottom="18dp" />

                    <!-- Business Description -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Business Description *" android:textColor="@color/text_primary"
                        android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutDescription"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
                        app:counterEnabled="true" app:counterMaxLength="300"
                        app:hintTextColor="@color/accent_teal"
                        android:hint="Describe your services, expertise and what you offer…">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDescription"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textColor="@color/text_primary" android:textColorHint="@color/input_hint"
                            android:textSize="15sp"
                            android:inputType="textMultiLine|textCapSentences"
                            android:lines="4" android:maxLines="6"
                            android:gravity="top|start" android:imeOptions="actionDone" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────── SECTION 3: Terms & Conditions ─────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="10dp">
                <View android:layout_width="4dp" android:layout_height="20dp"
                    android:background="@color/accent_purple" android:layout_marginEnd="10dp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Terms &amp; Conditions"
                    android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@color/surface_variant" android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" android:text="Step 3"
                    android:textColor="@color/accent_purple" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Scroll-to-read banner -->
                    <LinearLayout
                        android:id="@+id/tvScrollHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#FFF8E1"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="⬇️  " android:textSize="15sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Scroll to bottom to read all terms before ticking"
                            android:textColor="#E65100" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Terms ScrollView -->
                    <ScrollView
                        android:id="@+id/termsScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="@drawable/bg_terms_scroll"
                        android:padding="4dp"
                        android:scrollbars="vertical"
                        android:overScrollMode="always"
                        android:fadeScrollbars="false">

                        <TextView
                            android:id="@+id/tvTermsContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="14dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.6"
                            android:text="@string/provider_terms_full" />
                    </ScrollView>

                    <!-- Checkbox -->
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkboxTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="I have read and agree to all Terms &amp; Conditions"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:enabled="false" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ SUBMIT BUTTON ══ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="6dp"
                android:text="Submit Application"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:enabled="false"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/primary"
                app:icon="@drawable/ic_approval"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:elevation="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:text="Fill all required fields and accept terms to submit"
                android:textColor="#BDBDBD"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════ SUCCESS OVERLAY ══════════════ -->
    <FrameLayout
        android:id="@+id/successOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="310dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="24dp"
            app:cardElevation="20dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_success_circle"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Application Submitted!"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="🎉 Our team will review your application and get back to you shortly."
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.5"
                    android:paddingHorizontal="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSuccessHome"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Back to Home"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/primary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>


