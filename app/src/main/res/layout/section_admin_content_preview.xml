<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════════════
     ADMIN HOME CONTENT - BANNERS & OFFERS PREVIEW

     This layout shows admin-created banners and offers in the AdminDashboardActivity.
     Uses vertical RecyclerView for proper scrolling and listing.
     ════════════════════════════════════════════════════════════════════════ -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="20dp">

    <!-- ══ ADMIN BANNERS SECTION ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Promotional Banners"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageBanners"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Manage"
                android:textSize="11sp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/primary"
                android:minWidth="80dp"
                android:padding="0dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- Banners Content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <!-- ViewPager2 for carousel/preview -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpAdminBanners"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible" />

            <!-- Dots indicator -->
            <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
                android:id="@+id/adminBannerDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="12dp"
                app:dotsColor="#CCCCCC"
                app:selectedDotColor="@color/primary"
                app:dotRadius="3dp"
                app:dotsSpacing="6dp" />

            <!-- Loading state -->
            <ProgressBar
                android:id="@+id/progressAdminBanners"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Empty state -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                android:id="@+id/layoutAdminBannersEmpty">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_empty"
                    android:tint="@color/text_secondary"
                    android:scaleType="fitCenter"
                    android:contentDescription="No banners" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No banners created yet"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Error state -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                android:id="@+id/layoutAdminBannersError">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_error"
                    android:tint="@color/error_red"
                    android:scaleType="fitCenter"
                    android:contentDescription="Error" />

                <TextView
                    android:id="@+id/tvAdminBannersError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Failed to load banners"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryAdminBanners"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Retry"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/primary" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ══ ADMIN OFFERS SECTION ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Active Offers"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageOffers"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Manage"
                android:textSize="11sp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/primary"
                android:minWidth="80dp"
                android:padding="0dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- Offers Vertical RecyclerView -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp">

            <!-- RecyclerView - vertical scroll -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAdminOffers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="vertical"
                android:nestedScrollingEnabled="false"
                android:visibility="visible" />

            <!-- Loading state -->
            <ProgressBar
                android:id="@+id/progressAdminOffers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Empty state -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                android:id="@+id/layoutAdminOffersEmpty">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_empty"
                    android:tint="@color/text_secondary"
                    android:scaleType="fitCenter"
                    android:contentDescription="No offers" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No active offers"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Error state -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                android:id="@+id/layoutAdminOffersError">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_error"
                    android:tint="@color/error_red"
                    android:scaleType="fitCenter"
                    android:contentDescription="Error" />

                <TextView
                    android:id="@+id/tvAdminOffersError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Failed to load offers"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryAdminOffers"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Retry"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/primary" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

