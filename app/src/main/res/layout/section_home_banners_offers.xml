<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ════════════════════════════════════════════════════════════════════════
         HOME BANNERS & OFFERS SECTION LAYOUT

         This section should be integrated into activity_main.xml after the Featured Services
         and before the Provider Dashboard Banner section.

         Location in activity_main.xml: After </HorizontalScrollView> (line ~1100)
         Before <LinearLayout android:id="@+id/providerDashboardSection">
         ════════════════════════════════════════════════════════════════════════ -->

    <!-- ══ HOME BANNERS CAROUSEL SECTION ══ -->
    <LinearLayout
        android:id="@+id/bannersSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:visibility="visible">

        <!-- Content State (ViewPager2 Carousel) -->
        <FrameLayout
            android:id="@+id/bannerContentContainer"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:visibility="visible">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpBannersCarousel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible" />

            <!-- Dots Indicator -->
            <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
                android:id="@+id/bannerDotsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="12dp"
                app:dotsColor="#CCCCCC"
                app:selectedDotColor="@color/primary"
                app:dotsSize="8dp"
                app:dotsSpacing="8dp"
                app:dotsWidthFactor="2.5" />
        </FrameLayout>

        <!-- Loading State (Skeleton) -->
        <LinearLayout
            android:id="@+id/bannerLoadingState"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Skeleton card -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_skeleton"
                android:layout_marginHorizontal="4dp" />
        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/bannerEmptyState"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_empty"
                android:scaleType="fitCenter"
                android:tint="@color/text_secondary"
                android:contentDescription="No banners" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_banner_empty_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_banner_empty_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="6dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Error State -->
        <LinearLayout
            android:id="@+id/bannerErrorState"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_error"
                android:scaleType="fitCenter"
                android:tint="@color/error_red"
                android:contentDescription="Error" />

            <TextView
                android:id="@+id/tvBannerErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_banner_error_message"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryBannerLoad"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Retry"
                android:textSize="12sp"
                android:layout_marginTop="16dp"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══ HOME OFFERS SECTION ══ -->
    <LinearLayout
        android:id="@+id/offersSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:visibility="visible">

        <!-- Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Special Offers"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_gift"
                android:tint="@color/primary"
                android:contentDescription="Offers" />
        </LinearLayout>

        <!-- Content State (Horizontal RecyclerView) -->
        <FrameLayout
            android:id="@+id/offersContentContainer"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:visibility="visible">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOffersStrip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingEnd="16dp"
                android:visibility="visible" />
        </FrameLayout>

        <!-- Loading State (Skeleton) -->
        <LinearLayout
            android:id="@+id/offersLoadingState"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Multiple skeleton cards -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_skeleton"
                android:layout_marginEnd="8dp" />

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_skeleton"
                android:layout_marginEnd="8dp" />

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_skeleton"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/offersEmptyState"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_empty"
                android:scaleType="fitCenter"
                android:tint="@color/text_secondary"
                android:contentDescription="No offers" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_offers_empty_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_offers_empty_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="4dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Error State -->
        <LinearLayout
            android:id="@+id/offersErrorState"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_error"
                android:scaleType="fitCenter"
                android:tint="@color/error_red"
                android:contentDescription="Error" />

            <TextView
                android:id="@+id/tvOffersErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_offers_error_message"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryOffersLoad"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Retry"
                android:textSize="12sp"
                android:layout_marginTop="12dp"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/primary" />
        </LinearLayout>
    </LinearLayout>
</merge>
